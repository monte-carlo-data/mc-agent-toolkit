{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CORTEX_PLUGIN_ROOT}/hooks/telemetry/scripts/ensure-toolkit-ids.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(edit|write|multi_edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CORTEX_PLUGIN_ROOT}/hooks/prevent/pre_edit_hook.py\""
          }
        ]
      },
      {
        "matcher": "^bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CORTEX_PLUGIN_ROOT}/hooks/prevent/pre_commit_hook.py\""
          }
        ]
      },
      {
        "matcher": "^skill$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CORTEX_PLUGIN_ROOT}/hooks/telemetry/scripts/skill-beacon.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(edit|write|multi_edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CORTEX_PLUGIN_ROOT}/hooks/prevent/post_edit_hook.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CORTEX_PLUGIN_ROOT}/hooks/prevent/turn_end_hook.py\""
          }
        ]
      }
    ]
  }
}
